<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <data>
        <record id="ate_sh_scrap_order_view_form" model="ir.ui.view">
            <field name="name">sh.scrap.order.view.form</field>
            <field name="model">sh.scrap.order</field>
            <field name="inherit_id" ref="sh_multi_scrap_order.sh_scrap_order_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button class="oe_highlight" string="Update Analytic Lines" type="object"
                            name="update_analytic_distribution" invisible="state != 'draft'"/>
                </xpath>
                <!--                <xpath expr="//field[@name='company_id']" position="after">-->
                <xpath expr="//group/group[2]" position="inside">
                    <label for="analytic_distribution" string="Analytic Distribution"/>
                    <div>
                        <field name="analytic_distribution" widget="analytic_distribution"
                               options="{'account_field': 'analytic_account_id','product_field': 'product_id', 'business_domain': 'optional'}"
                               groups="analytic.group_analytic_accounting" required="1" readonly="state != 'draft'"
                        />
                        <button name="update_analytic_distribution" string="Update Analytic Distribution"
                                type="object" class="oe_link"
                                groups="analytic.group_analytic_accounting"
                        />
                    </div>
                </xpath>
                <xpath expr="//field[@name='sh_scrap_order_line']//tree//field[@name='product_uom_category_id']"
                       position="after">
                    <field name="analytic_distribution" widget="analytic_distribution"
                           groups="analytic.group_analytic_accounting" readonly="1" optional="show"/>
                </xpath>

            </field>
        </record>
    </data>

</odoo>