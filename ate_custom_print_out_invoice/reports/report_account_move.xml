<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="ate_invoice_header_footer">
        <div class="header" style="font-family: Arial; font-size: 14px;">
            <div class="row">
                <div class="col-6">
                    <t t-if="o.company_id.name">
                        <span t-field="o.company_id.name" style="font-weight: bold;"/>
                    </t>
                    <t t-if="o.company_id.street">
                        <br/>
                        <span t-field="o.company_id.street"/>
                    </t>
                    <t t-if="o.company_id.street2">
                        <br/>
                        <span t-field="o.company_id.street2"/>
                    </t>
                    <t t-if="o.company_id.city">
                        <br/>
                        <span t-field="o.company_id.city"/>
                    </t>
                    <t t-if="o.company_id.state_id">
                        <span t-field="o.company_id.state_id"/>
                    </t>
                    <t t-if="o.company_id.zip">
                        <span t-field="o.company_id.zip"/>
                    </t>
                    <t t-if="o.company_id.country_id">
                        <br/>
                        <span t-field="o.company_id.country_id"/>
                    </t>
                </div>
                <div class="col-6 text-end">
                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)"
                         alt="Logo" width="90%"/>
                </div>
            </div>

            <div class="row">
                <div class="col-6"></div>
                <div class="col-6" style="text-align:right; font-weight: bold;">
                    <t t-if="o.print_count == 1">
                        <span>ORIGINAL PRINT</span>
                    </t>
                    <t t-else="">
                        <span>
                            DUPLICATE PRINT #<t t-esc="o.print_count - 1"/>
                        </span>
                    </t>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <table class="table-borderless" style="width: 100%;">
                        <tr>
                            <td rowspan="4" style="border:1px solid black; border-right:0px;" width="5%">
                                <span>To</span>
                            </td>
                            <td rowspan="4" style="border:1px solid black; border-left:0px;" width="45%">
                                <t t-if="o.partner_id.name">
                                    <span t-field="o.partner_id.name" style="font-weight: bold;"/>
                                </t>
                                <t t-if="o.partner_id.street">
                                    <br/>
                                    <span t-field="o.partner_id.street"/>
                                </t>
                                <t t-if="o.partner_id.street2">
                                    <br/>
                                    <span t-field="o.partner_id.street2"/>
                                </t>
                                <t t-if="o.partner_id.city">
                                    <br/>
                                    <span t-field="o.partner_id.city"/>
                                </t>
                                <t t-if="o.partner_id.state_id">
                                    <span t-field="o.partner_id.state_id"/>
                                </t>
                                <t t-if="o.partner_id.zip">
                                    <span t-field="o.partner_id.zip"/>
                                </t>
                                <t t-if="o.partner_id.country_id">
                                    <br/>
                                    <span t-field="o.partner_id.country_id"/>
                                </t>
                            </td>
                            <td style="border-top:1px solid black; padding-left: 30px;" width="25%">
                                <span>No.</span>
                            </td>
                            <td style="border-top:1px solid black; border-right:1px solid black;" width="25%">
                                <span style="font-weight: bold;" t-field="o.name"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding-left: 30px;">
                                <span>Date</span>
                            </td>
                            <td style="border-right:1px solid black;">
                                <t t-if="o.invoice_date">
                                    <span style="font-weight: bold;" t-field="o.invoice_date"
                                          t-options="{'widget': 'date'}"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding-left: 30px;">
                                <span>VAT/Ref No.</span>
                            </td>
                            <td style="border-right:1px solid black;">
                                <span t-field="o.l10n_id_tax_number"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-top:1px solid black; border-right:1px solid black; border-bottom:1px solid black; padding-left:30px;"
                                colspan="2" height="50px">
                                <span>Payment Term:</span>
                                <br/>
                                <span t-field="o.invoice_payment_term_id.name"/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <br/>
        </div>
    </template>

    <template id="report_ate_invoice_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="ate_custom_print_out_invoice.ate_invoice_header_footer"/>
                <div class="article">
                    <div class="page" style="font-family: Arial; font-size: 12px;">
                        <table class="table table-borderless o_main_table" width="100%">
                            <thead>
                                <tr style="border-top:1px solid black; border-bottom:1px solid black;">
                                    <th style="text-align:left;" width="5%">No</th>
                                    <th style="text-align:left;" width="51%">Product Key / Name</th>
                                    <!-- <th style="text-align:right;" width="11%">Termin</th> -->
                                    <th style="text-align:center;" width="11%">Qty UOM</th>
                                    <th style="text-align:right;" width="11%">Price</th>
                                    <th style="text-align:center;" name="th_taxes" t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Taxes</span></th>
                                    <th style="text-align:right;" width="11%">Line Amt</th>
                                </tr>
                            </thead>
                            <t t-set="counter" t-value="0"/>
                            <tbody>
                                <t t-foreach="o.invoice_line_ids" t-as="line">
                                    <t t-set="counter" t-value="counter + 1"/>
                                    <tr>
                                        <td style="text-align:right;">
                                            <span t-esc="counter"/>
                                        </td>
                                        <td style="text-align:left;">
                                            <span t-field="line.name"/>
                                            <br/>
                                            <span>Customer Reference :</span>
                                            <t t-if="o.ref">
                                                <span t-field="o.ref"/>
                                            </t>
                                            <t t-else="">
                                                <span>-</span>
                                            </t>
                                            <br/>
                                            <span>Site ID :</span>
                                            <t t-if="line.site_id">
                                                <span t-field="line.site_id"/>
                                            </t>
                                            <t t-else="">
                                                <span>-</span>
                                            </t>
                                            <br/>
                                            <span>Site Name :</span>
                                            <t t-if="line.site_name">
                                                <span t-field="line.site_name"/>
                                            </t>
                                            <t t-else="">
                                                <span>-</span>
                                            </t>
                                            <br/>
                                            <span>Subcontract No. :</span>
                                            <t t-if="o.invoice_line_ids.sale_line_ids.order_id.sub_contract_number">
                                                <span t-field="o.invoice_line_ids.sale_line_ids.order_id.sub_contract_number"/>
                                            </t>
                                            <t t-else="">
                                                <span>-</span>
                                            </t>
                                        </td>
                                        <!-- <td style="text-align:right;">
                                            <span>
                                                <t t-esc="line.termin_percentage"/>
                                            </span>
                                        </td> -->
                                        <td style="text-align:center;">
                                            <span t-esc="line.quantity"/>
                                            <span t-field="line.product_uom_id.name"/>
                                        </td>
                                        <td style="text-align:right;">
                                            <span t-field="line.price_unit"/>
                                        </td>
                                        <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"/>
                                            <td style="text-align: right;" name="td_taxes" t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                                <span t-out="taxes" id="line_tax_ids">Tax</span>
                                            </td>
                                        <td style="text-align:right;">
                                            <span t-field="line.price_subtotal"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="row" style="border-top:1px solid black;">
                            <div class="col-8"></div>
                            <div class="col-4 text-end">
                                <table class="table-borderless" width="100%">
                                    <tr>
                                        <td>
                                            <span>Sub-total :</span>
                                            <span t-field="o.currency_id.symbol"/>
                                        </td>
                                        <td>
                                            <span t-esc="'{:,.2f}'.format(o.amount_untaxed)"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>PPN</td>
                                        <td>
                                            <span t-esc="'{:,.2f}'.format(o.amount_tax)"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight: bold;">
                                            <span>Total :</span>
                                            <span t-field="o.currency_id.symbol"/>
                                        </td>
                                        <td style="font-weight: bold;">
                                            <span t-esc="'{:,.2f}'.format(o.amount_total)"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <br/>

                        <div class="row" style="page-break-inside: avoid;">
                            <div class="col-12">
                                <span t-esc="o.text_indonesian()"/>
                            </div>
                        </div>
                        <br/>

                        <div class="row" style="page-break-inside: avoid;">
                            <div class="col-12">
                                <div>
                                    <span>Bank Account:</span>
                                </div>
                                <div>
                                    <span t-field="o.partner_bank_id.acc_holder_name"/>
                                </div>
                                <div>
                                    <span t-field="o.partner_bank_id.bank_id"/>
                                    <span t-field="o.partner_bank_id.acc_number"/>
                                </div>
                                <div>
                                    <span t-field="o.partner_bank_id.currency_id"/>
                                </div>
                            </div>
                        </div>
                        <br/>
                        <br/>

                        <div style="page-break-inside: avoid;">
                            <div class="row">
                                <div class="col-12">
                                    <div>
                                        <span>Your Faithfully,</span>
                                    </div>
                                    <div>
                                        <span t-field="o.company_id.name" style="font-style: italic"/>
                                    </div>
                                </div>
                            </div>
                            <br/>
                            <br/>
                            <br/>

                            <div class="row">
                                <div class="col-12">
                                    <div>
                                        <span t-field="o.company_id.customer_invoice_signature"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>