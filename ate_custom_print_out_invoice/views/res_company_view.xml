<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_company_form_inherit_ate_invoice" model="ir.ui.view">
        <field name="name">res.company.form.ate.invoice.signature</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']/group" position="after">
                <group>
                    <group string="ATE INVOICE" name="ate_invoice">
                        <field name="customer_invoice_signature"/>
                    </group>
                    <group></group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>