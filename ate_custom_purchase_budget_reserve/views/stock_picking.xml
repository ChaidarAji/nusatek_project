<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <data>


        <record id="stock_picking_from_inherit1" model="ir.ui.view">
            <field name="name">stock.picking.inherit.view.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">

                <xpath expr="//button[@name='%(stock.act_stock_return_picking)d']" position="replace">
                    <button name="action_stock_return_picking" string="Return" invisible="state != 'done'" type="object" groups="base.group_user" data-hotkey="k"/>
                </xpath>

            </field>
        </record>

    </data>

</odoo>